# Apache 2.4 (.htaccess in the folder that holds usage.json): serve it only with the right X-Key header.
# Replace CHANGE_ME with your secret (the value of the Keychain item ai-sphere-watch-key).
# Needs AllowOverride AuthConfig FileInfo (most shared hosting allows it) and mod_headers.
# If the server ignores .htaccess (AllowOverride None) the file would be public: after installing,
# run hosting/check.sh, which must report 403 without the key.

# Case-insensitive, so USAGE.JSON cannot bypass the check on case-insensitive file systems.
<FilesMatch "(?i)^usage\.json$">
    Require expr "%{HTTP:X-Key} == 'CHANGE_ME'"
    ForceType application/json
    <IfModule mod_headers.c>
        # private: the response depends on the X-Key, so shared caches in front must not reuse it.
        Header set Cache-Control "private, max-age=60"
        Header set Vary "X-Key"
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>

# Keep the temporary upload names private.
<FilesMatch "(?i)\.tmp$">
    Require all denied
</FilesMatch>
